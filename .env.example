# Base de datos Postgres (Neon, Supabase, o local)
# En producción (Vercel) esto debe ser la connection string "pooled" de Neon
# (la que incluye -pooler / pgbouncer=true): en serverless se abren muchas
# conexiones concurrentes y el pooler las absorbe.
DATABASE_URL="postgresql://usuario:password@localhost:5432/bitacora"

# Connection string "direct" de Neon, SIN pooling (sin -pooler / pgbouncer).
# Prisma la usa solo para correr migraciones (prisma migrate deploy/dev).
# En desarrollo local podés ponerle el mismo valor que DATABASE_URL.
DIRECT_URL="postgresql://usuario:password@localhost:5432/bitacora"

# NextAuth
# Generá un valor con: openssl rand -base64 32
# El valor de ejemplo de abajo NUNCA debe usarse en producción: generá uno propio
# y cargalo como variable de entorno en Vercel.
NEXTAUTH_SECRET="reemplazar-por-un-secreto-generado"
NEXTAUTH_URL="http://localhost:3000"
